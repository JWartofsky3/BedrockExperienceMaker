{
  "name": "bedrock-experience-maker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "backend": "go -C api run ./cmd/server",
    "db:start": "powershell.exe -NoProfile -Command \"if ((Get-Service -Name MySQL).Status -ne 'Running') { Start-Service -Name MySQL }\"",
    "dev": "vite",
    "full": "npm run db:start && start \"Bedrock API\" powershell.exe -NoExit -NoProfile -Command \"Set-Location '%CD%'; $env:MYSQL_DSN = 'bedrock_app:change-me@tcp(127.0.0.1:3306)/bedrock_experience_maker?parseTime=true'; npm.cmd run backend\" && npm run dev",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1"
  }
}
